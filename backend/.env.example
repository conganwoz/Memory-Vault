# Copy to .env and adjust. Generate secrets with:  mix phx.gen.secret

# JWT / cookie signing secrets (set strong random values for anything shared)
SECRET_KEY_BASE=change_me
GUARDIAN_SECRET_KEY=change_me

# Postgres credentials used by the db service
POSTGRES_PASSWORD=kindred

# Host port the API is exposed on
PORT=4008

# Optional integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_IDS=
CORS_ORIGIN=*

# Public URL used in verification emails (e.g. https://api.kindred.app)
APP_URL=http://localhost:4008

# Transactional email delivery (Resend). Leave empty to log verification
# links in the backend logs instead of sending real emails. Put real values
# in .env (gitignored), not here.
MAILER_PROVIDER=
MAILER_FROM=
MAILER_API_KEY=

# Set to "true" to run the demo seed on container start
SEED_ON_START=false
